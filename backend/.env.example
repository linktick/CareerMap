# 大模型 API Key（必填）——通用 OpenAI 兼容接口
LLM_API_KEY=your_api_key_here

# 上游大模型接口地址（OpenAI 兼容的 /chat/completions 端点），切换厂商只需改这三行：
#   DeepSeek:   https://api.deepseek.com/v1
#   Kimi:       https://api.moonshot.cn/v1
#   通义千问:   https://dashscope.aliyuncs.com/compatible-mode/v1
#   豆包方舟:   https://ark.cn-beijing.volces.com/api/v3
#   豆包套餐端点: https://ark.cn-beijing.volces.com/api/plan/v3（配合 DOUBAO_* 变量名）
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型 ID（留空则需在前端设置中指定）
LLM_MODEL=deepseek-chat

# 允许跨域的前端地址（逗号分隔）
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============ 实时联网搜索（Agent 的 search_web 工具）============
# 渠道降级顺序：① 火山方舟联网搜索 API（Agent 套餐自带，默认零配置）
#               → ② 博查 Bocha（国内中文招聘内容质量好，推荐备用）→ ③ Tavily。
# 全部不可用时 /api/search 返回 503，前端自动把调研报告标记为「未核验」，不会编造来源。
#
# ① 方舟联网搜索：Agent 套餐（DOUBAO_BASE_URL=/api/plan/v3）附赠的搜索通道，
#    直接复用上面的套餐 Key，无需任何额外配置（需已开通「联网搜索 API」：
#    https://console.volcengine.com/search-infinity/web-search ）。
#    若使用单独签发的搜索 Key，可填这里（https://console.volcengine.com/search-infinity/api-key）：
# ARK_SEARCH_API_KEY=
#
# SEARCH_PROVIDER=auto（默认，按上面顺序自动降级）| ark | bocha | tavily | none（强制关闭）
SEARCH_PROVIDER=auto

# ② 博查搜索 API Key（可选，方舟渠道不可用时的备用）：https://open.bochaai.com
# BOCHA_API_KEY=

# ③ Tavily API Key（可选，海外渠道）：https://tavily.com
# TAVILY_API_KEY=
